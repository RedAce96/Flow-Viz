              "$ref": "#/$defs/SinglePulseAnalysis"
            },
            {
              "$ref": "#/$defs/DirectionalWaveAnalysis"
            },
            {
              "$ref": "#/$defs/TransientWavepacketAnalysis"
            },
            {
              "$ref": "#/$defs/NonlinearCouplingAnalysis"
            },
            {
              "$ref": "#/$defs/ModalScreeningAnalysis"
            },
            {
              "$ref": "#/$defs/CaseComparisonAnalysis"
            }
          ]
        },
        "title": "Analyses",
        "type": "array"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      }
    },
    "title": "AnalysesFile",
    "type": "object"
  },
  "case.yaml": {
    "$defs": {
      "CaseIdentity": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "dimensionality": {
            "default": 2,
            "enum": [
              2,
              3
            ],
            "title": "Dimensionality",
            "type": "integer"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Id",
            "type": "string"
          },
          "solver": {
            "const": "pelec",
            "default": "pelec",
            "title": "Solver",
            "type": "string"
          },
          "solver_units": {
            "$ref": "#/$defs/SolverUnits",
            "default": "cgs"
          }
        },
        "required": [
          "id"
        ],
        "title": "CaseIdentity",
        "type": "object"
      },
      "ExplicitFreestream": {
        "additionalProperties": false,
        "properties": {
          "density_kg_m3": {
            "exclusiveMinimum": 0.0,
            "title": "Density Kg M3",
            "type": "number"
          },
          "pressure_pa": {
            "exclusiveMinimum": 0.0,
            "title": "Pressure Pa",
            "type": "number"
          },
          "source": {
            "const": "explicit",
            "default": "explicit",
            "title": "Source",
            "type": "string"
          },
          "temperature_k": {
            "exclusiveMinimum": 0.0,
            "title": "Temperature K",
            "type": "number"
          },
          "velocity_m_s": {
            "exclusiveMinimum": 0.0,
            "title": "Velocity M S",
            "type": "number"
          }
        },
        "required": [
          "density_kg_m3",
          "velocity_m_s",
          "pressure_pa",
          "temperature_k"
        ],
        "title": "ExplicitFreestream",
        "type": "object"
      },
      "FlatPlateGeometry": {
        "additionalProperties": false,
        "properties": {
          "fluid_side": {
            "default": "above",
            "enum": [
              "above",
              "below"
            ],
            "title": "Fluid Side",
            "type": "string"
          },
          "leading_edge_x_m": {
            "default": 0.0,
            "title": "Leading Edge X M",
            "type": "number"
          },
          "trailing_edge_x_m": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Trailing Edge X M"
          },
          "type": {
            "const": "flat_plate",
            "default": "flat_plate",
            "title": "Type",
            "type": "string"
          },
          "wall_y_m": {
            "default": 0.0,
            "title": "Wall Y M",
            "type": "number"
          }
        },
        "title": "FlatPlateGeometry",
        "type": "object"
      },
      "GasConfig": {
        "additionalProperties": false,
        "properties": {
          "gamma": {
            "default": 1.4,
            "exclusiveMinimum": 1.0,
            "title": "Gamma",
            "type": "number"
          },
          "gas_constant_j_kg_k": {
            "default": 287.05,
            "exclusiveMinimum": 0.0,
            "title": "Gas Constant J Kg K",
            "type": "number"
          }
        },
        "title": "GasConfig",
        "type": "object"
      },
      "PolylineGeometry": {
        "additionalProperties": false,
        "properties": {
          "closed": {
            "default": false,
            "title": "Closed",
            "type": "boolean"
          },
          "fluid_side": {
            "enum": [
              "left",
              "right",
              "outside",
              "inside"
            ],
            "title": "Fluid Side",
            "type": "string"
          },
          "points_m": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "title": "Points M",
            "type": "array"
          },
          "type": {
            "const": "polyline",
            "default": "polyline",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "points_m",
          "fluid_side"
        ],
        "title": "PolylineGeometry",
        "type": "object"
      },
      "RegionBounds": {
        "additionalProperties": false,
        "properties": {
          "x_m": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "X M",
            "type": "array"
          },
          "y_m": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Y M",
            "type": "array"
          }
        },
        "required": [
          "x_m",
          "y_m"
        ],
        "title": "RegionBounds",
        "type": "object"
      },
      "RegionFreestream": {
        "additionalProperties": false,
        "properties": {
          "bounds": {
            "$ref": "#/$defs/RegionBounds"
          },
          "source": {
            "const": "region",
            "default": "region",
            "title": "Source",
            "type": "string"
          },
          "statistic": {
            "default": "median",
            "enum": [
              "median",
              "mean"
            ],
            "title": "Statistic",
            "type": "string"
          }
        },
        "required": [
          "bounds"
        ],
        "title": "RegionFreestream",
        "type": "object"
      },
      "SolverUnits": {
        "enum": [
          "cgs",
          "si"
        ],
        "title": "SolverUnits",
        "type": "string"
      },
      "VolumeFractionGeometry": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "default": "volume_fraction",
            "title": "Field",
            "type": "string"
          },
          "fluid_value": {
            "default": 1,
            "enum": [
              0,
              1
            ],
            "title": "Fluid Value",
            "type": "integer"
          },
          "iso_value": {
            "default": 0.5,
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Iso Value",
            "type": "number"
          },
          "minimum_component_points": {
            "default": 8,
            "exclusiveMinimum": 0,
            "title": "Minimum Component Points",
            "type": "integer"
          },
          "type": {
            "const": "volume_fraction",
            "default": "volume_fraction",
            "title": "Type",
            "type": "string"
          }
        },
        "title": "VolumeFractionGeometry",
        "type": "object"
      },
      "WedgeGeometry": {
        "additionalProperties": false,
        "properties": {
          "fluid_side": {
            "default": "outside",
            "enum": [
              "outside",
              "inside"
            ],
            "title": "Fluid Side",
            "type": "string"
          },
          "half_angle_deg": {
            "exclusiveMaximum": 90.0,
            "exclusiveMinimum": 0.0,
            "title": "Half Angle Deg",
            "type": "number"
          },
          "leading_edge_x_m": {
            "title": "Leading Edge X M",
            "type": "number"
          },
          "leading_edge_y_m": {
            "title": "Leading Edge Y M",
            "type": "number"
          },
          "length_m": {
            "exclusiveMinimum": 0.0,
            "title": "Length M",
            "type": "number"
          },
          "type": {
            "const": "wedge",
            "default": "wedge",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "leading_edge_x_m",
          "leading_edge_y_m",
          "length_m",
          "half_angle_deg"
        ],
        "title": "WedgeGeometry",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "case": {
        "$ref": "#/$defs/CaseIdentity"
      },
      "field_aliases": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Field Aliases",
        "type": "object"
      },
      "freestream": {
        "discriminator": {
          "mapping": {
            "explicit": "#/$defs/ExplicitFreestream",
            "region": "#/$defs/RegionFreestream"
          },
          "propertyName": "source"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ExplicitFreestream"
          },
          {
            "$ref": "#/$defs/RegionFreestream"
          }
        ],
        "title": "Freestream"
      },
      "gas": {
        "$ref": "#/$defs/GasConfig",
        "default": {
          "gamma": 1.4,
          "gas_constant_j_kg_k": 287.05
        }
      },
      "geometry": {
        "discriminator": {
          "mapping": {
            "flat_plate": "#/$defs/FlatPlateGeometry",
            "polyline": "#/$defs/PolylineGeometry",
            "volume_fraction": "#/$defs/VolumeFractionGeometry",
            "wedge": "#/$defs/WedgeGeometry"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/FlatPlateGeometry"
          },
          {
            "$ref": "#/$defs/WedgeGeometry"
          },
          {
            "$ref": "#/$defs/PolylineGeometry"
          },
          {
            "$ref": "#/$defs/VolumeFractionGeometry"
          }
        ],
        "title": "Geometry"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      }
    },
    "required": [
      "case",
      "freestream",
      "geometry"
    ],
    "title": "CaseFile",
    "type": "object"
  },
  "machine.yaml": {
    "$defs": {
      "ComputeConfig": {
        "additionalProperties": false,
        "properties": {
          "fft_batch_size": {
            "default": 32,
            "exclusiveMinimum": 0,
            "title": "Fft Batch Size",
            "type": "integer"
          },
          "memory_limit_gb": {
            "default": 8.0,
            "exclusiveMinimum": 0.0,
            "title": "Memory Limit Gb",
            "type": "number"
          },
          "scratch_directory": {
            "anyOf": [
              {
                "format": "path",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scratch Directory"
          },
          "workers": {
            "default": 1,
            "exclusiveMinimum": 0,
            "title": "Workers",
            "type": "integer"
          }
        },
        "title": "ComputeConfig",
        "type": "object"
      },
      "InputConfig": {
        "additionalProperties": false,
        "properties": {
          "baselines": {
            "additionalProperties": {
              "$ref": "#/$defs/PlotfileInput"
            },
            "title": "Baselines",
            "type": "object"
          },
          "comparison_archives": {
            "default": [],
            "items": {
              "format": "path",
              "type": "string"
            },
            "title": "Comparison Archives",
            "type": "array"
          },
          "plotfiles": {
            "anyOf": [
              {
                "$ref": "#/$defs/PlotfileInput"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "probes": {
            "anyOf": [
              {
                "$ref": "#/$defs/ProbeInput"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "title": "InputConfig",
        "type": "object"
      },
      "OutputConfig": {
        "additionalProperties": false,
        "properties": {
          "root": {
            "format": "path",
            "title": "Root",
            "type": "string"
          }
        },
        "required": [
          "root"
        ],
        "title": "OutputConfig",
        "type": "object"
      },
      "PlotfileInput": {
        "additionalProperties": false,
        "properties": {
          "prefix": {
            "default": "plt",
            "title": "Prefix",
            "type": "string"
          },
          "source": {
            "format": "path",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "title": "PlotfileInput",
        "type": "object"
      },
      "ProbeInput": {
        "additionalProperties": false,
        "properties": {
          "binary_files": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Binary Files",
            "type": "array"
          },
          "compact_file": {
            "anyOf": [
              {
                "format": "path",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Compact File"
          }
        },
        "title": "ProbeInput",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "compute": {
        "$ref": "#/$defs/ComputeConfig",
        "default": {
          "fft_batch_size": 32,
          "memory_limit_gb": 8.0,
          "scratch_directory": null,
          "workers": 1
        }
      },
      "inputs": {
        "$ref": "#/$defs/InputConfig",
        "default": {
          "baselines": {},
          "comparison_archives": [],
          "plotfiles": null,
          "probes": null
        }
      },
      "outputs": {
        "$ref": "#/$defs/OutputConfig"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      }
    },
    "required": [
      "outputs"
    ],
    "title": "MachineFile",
    "type": "object"
  }
}
