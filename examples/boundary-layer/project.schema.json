        "title": "CaseComparisonAnalysis",
        "type": "object"
      },
      "DirectionalWaveAnalysis": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "expected_speed_max_m_s": {
            "anyOf": [
