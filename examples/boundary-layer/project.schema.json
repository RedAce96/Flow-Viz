{
  "analyses.yaml": {
    "$defs": {
      "AerodynamicForcesAnalysis": {
        "additionalProperties": false,
        "properties": {
          "baseline": {
            "default": "none",
            "enum": [
              "none",
              "static",
              "paired"
            ],
            "title": "Baseline",
            "type": "string"
          },
          "baseline_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Baseline Id"
          },
          "conductivity_w_m_k": {
            "exclusiveMinimum": 0.0,
            "title": "Conductivity W M K",
            "type": "number"
          },
          "dynamic_viscosity_pa_s": {
            "exclusiveMinimum": 0.0,
            "title": "Dynamic Viscosity Pa S",
            "type": "number"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Id",
            "type": "string"
          },
          "moment_origin_m": {
            "default": [
              0.0,
              0.0
            ],
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Moment Origin M",
            "type": "array"
          },
          "normal_sample_distance_m": {
            "default": 0.001,
            "exclusiveMinimum": 0.0,
            "title": "Normal Sample Distance M",
            "type": "number"
          },
          "normal_sample_points": {
            "default": 8,
            "exclusiveMinimum": 0,
            "title": "Normal Sample Points",
            "type": "integer"
          },
          "recipe": {
            "const": "aerodynamic_forces",
            "title": "Recipe",
            "type": "string"
          },
          "reference_chord_m": {
            "exclusiveMinimum": 0.0,
            "title": "Reference Chord M",
            "type": "number"
          },
          "reference_span_m": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Reference Span M",
            "type": "number"
          },
          "wall_temperature_k": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Wall Temperature K"
          }
        },
        "required": [
          "id",
          "recipe",
          "reference_chord_m",
          "dynamic_viscosity_pa_s",
          "conductivity_w_m_k"
        ],
        "title": "AerodynamicForcesAnalysis",
        "type": "object"
      },
      "BoundaryLayerAnalysis": {
        "additionalProperties": false,
        "properties": {
          "conductivity_w_m_k": {
            "exclusiveMinimum": 0.0,
            "title": "Conductivity W M K",
